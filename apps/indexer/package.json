{
  "name": "foresight-indexer",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "update": "bash ./scripts/update.sh",
    "update:local": "bash ./scripts/update.sh localhost",
    "update:gnosis": "bash ./scripts/update.sh gnosis",
    "codegen": "yarn codegen:gnosis && yarn codegen:local",
    "codegen:local": "envio codegen --config config.localhost.yaml",
    "codegen:gnosis": "envio codegen --config config.gnosis.yaml",
    "dev": "envio dev --config config.localhost.yaml",
    "dev:gnosis": "node --env-file=.env.gnosis \"$(yarn bin envio)\" dev --config config.gnosis.yaml",
    "start": "envio start",
    "start:local": "envio start --config config.localhost.yaml",
    "stop": "envio stop",
    "test": "ENVIO_CONFIG=config.localhost.yaml vitest run --test-timeout=10000",
    "lint": "bash ./scripts/check-deployable.sh && eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": "@foresight/prettier-config",
  "devDependencies": {
    "eslint": "^9.28.0",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "envio": "^3.2.1",
    "viem": "^2.55.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
