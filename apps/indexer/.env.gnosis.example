# copy to .env.gnosis, then `yarn dev:gnosis`. Layered over .env, so only what
# differs from the local stack belongs here. Envio Cloud reads none of this.

# Chain 100 contract reads, tried in order. Either may be empty
ENVIO_GNOSIS_RPC_URL=
ENVIO_GNOSIS_FALLBACK_RPC_URL=

# A real gateway, not the local mock
ENVIO_IPFS_GATEWAY=
