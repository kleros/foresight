# copy to .env.gnosis, then `yarn dev:gnosis`. Layered over .env.local, so only
# what differs from the local stack belongs here.

# Removes hardhat from Supported chains and interface only shows gnosis. 
# For local use, on prod the NODE_ENV flag removes the chain.
NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=false

# The deployed indexer, not the local one
NEXT_PUBLIC_SUBGRAPH_URL=

# Real Atlas, uploads only
NEXT_PUBLIC_ATLAS_URI=

NEXT_PUBLIC_IPFS_GATEWAY=https://cdn.kleros.link/ipfs

# Optional; public endpoints otherwise
NEXT_PUBLIC_GNOSIS_RPC=
