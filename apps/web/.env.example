# copy to .env.local

# Subgraph url
NEXT_PUBLIC_SUBGRAPH_URL=http://localhost:8080/v1/graphql

# Reown/WalletConnect project id , https://dashboard.reown.com (required)
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Gnosis RPC; falls back to public endpoints. Point at the Tenderly fork for e2e (optional)
NEXT_PUBLIC_GNOSIS_RPC=

# Public site origin, used for AppKit metadata (optional)
NEXT_PUBLIC_SITE_URL=

# Atlas Endpoint
NEXT_PUBLIC_ATLAS_URI=
