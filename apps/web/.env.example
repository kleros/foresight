# copy to .env.local. These are the local stack's values; fill in the Reown id.
# Also the base for `yarn dev:gnosis`, which layers .env.gnosis on top.

# https://dashboard.reown.com (required)
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Indexer GraphQL, from `yarn indexer:dev`
NEXT_PUBLIC_SUBGRAPH_URL=http://localhost:8080/v1/graphql

# Atlas origin only, kleros-app appends /graphql. Here, `yarn mock-atlas`
NEXT_PUBLIC_ATLAS_URI=http://127.0.0.1:4747

# Where uploads are read back from; Atlas itself is upload-only
NEXT_PUBLIC_IPFS_GATEWAY=http://127.0.0.1:4747/ipfs

# AppKit metadata (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Empty follows NODE_ENV; .env.gnosis sets "false"
NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=
