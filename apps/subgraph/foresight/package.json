{
  "name": "foresight-subgraph",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sync-abis": "sh ./scripts/sync-abis.sh",
    "update:localhost": "sh ./scripts/update.sh localhost mainnet",
    "update:gnosis": "sh ./scripts/update.sh gnosis gnosis",
    "codegen": "graph codegen",
    "build": "graph build",
    "test": "graph codegen && graph test",
    "clean": "graph clean; rm -f subgraph.yaml.bak.*",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:local": "yarn update:localhost && yarn codegen && yarn build && (yarn create-local || true) && yarn deploy-local",
    "create-local": "graph create --node http://localhost:8020/ foresight",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 -l v$npm_package_version foresight",
    "check-types": "graph codegen"
  },
  "devDependencies": {
    "@foresight/contracts": "workspace:*",
    "@foresight/prettier-config": "workspace:*",
    "@foresight/typescript-config": "workspace:*",
    "@graphprotocol/graph-cli": "^0.97.0",
    "@graphprotocol/graph-ts": "^0.38.0",
    "matchstick-as": "^0.6.0",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3"
  },
  "prettier": "@foresight/prettier-config"
}
