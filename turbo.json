{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["CI", "NODE_ENV", "MOCK_ATLAS_PORT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "format": {},
    "format:check": {},
    "test": { "dependsOn": ["^test"] },
    "check-types": { "dependsOn": ["^check-types"] }
  }
}
