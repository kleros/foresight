{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["CI", "NODE_ENV", "MOCK_ATLAS_PORT", "MOCK_ATLAS_STORE_DIR", "MOCK_ATLAS_UPSTREAM_GATEWAYS"],
  "//": "FORK_* configure the gnosis-fork integration test, which skips when FORK_RPC_URL is unset.",
  "globalPassThroughEnv": ["FORK_RPC_URL", "FORK_HASURA_URL", "FORK_HASURA_SECRET", "FORK_UPSTREAM_RPC_URL", "E2E_BASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "format": {},
    "format:check": {},
    "test": { "dependsOn": ["^test"], "env": ["TZ"] },
    "check-types": { "dependsOn": ["^check-types"] }
  }
}
