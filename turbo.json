{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["CI"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "format": {},
    "format:check": {},
    "test": { "dependsOn": ["^test"] },
    "check-types": { "dependsOn": ["^check-types"] }
  }
}
