# copy to .env.local
#
# Turbo cache keys for these vars: packages/contracts/turbo.json (per-task `env`).

# Optional: override Seer MarketFactory (default: @seer-pm/contracts deployments, else mock on localhost)
# SEER_MARKET_FACTORY_ADDRESS=

# Remote networks
# GNOSIS_RPC_URL=
# TENDERLY_RPC_URL=
