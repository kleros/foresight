# copy to .env.local
#
# Turbo cache keys for these vars: packages/contracts/turbo.json (per-task `env`).

# Optional: override Seer MarketFactory (default: @seer-pm/contracts deployments, else mock on localhost)
# SEER_MARKET_FACTORY_ADDRESS=

# Remote networks
# GNOSIS_RPC_URL=
# TENDERLY_RPC_URL=

# Deploy signer for gnosis/tenderly; unset for local work
DEPLOYER_PRIVATE_KEY=
# Blockscout multichain API key, for `yarn verify:gnosis`
BLOCKSCOUT_API_KEY=
