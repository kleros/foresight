{
  "name": "@foresight/contracts",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./deployments/viem.ts",
      "default": "./deployments/viem.ts"
    },
    "./deployments/*": "./deployments/*"
  },
  "files": [
    "contracts",
    "deployments",
    "!deployments/localhost",
    "!deployments/hardhat"
  ],
  "scripts": {
    "build": "hardhat compile",
    "codegen:localhost": "NODE_NO_WARNINGS=1 wagmi generate -c wagmi.config.localhost.mts",
    "codegen:gnosis": "NODE_NO_WARNINGS=1 wagmi generate -c wagmi.config.gnosis.mts",
    "test": "hardhat test",
    "local-node": "hardhat node --port 8545 --tags SessionFactory",
    "start": "yarn build && yarn local-node",
    "deploy": "hardhat deploy",
    "deploy:local": "hardhat deploy --network localhost --tags SessionFactory && yarn codegen:localhost",
    "simulate:session": "hardhat simulate-session --network localhost",
    "deploy:gnosis": "hardhat deploy --network gnosis --tags SessionFactory && yarn codegen:gnosis",
    "lint": "sh -c 'hardhat check; r1=$?; eslint . --max-warnings 0; r2=$?; exit $((r1 | r2))'",
    "format:sol": "prettier --write \"contracts/**/*.sol\"",
    "format:ts": "prettier --write \"**/*.{ts,mts,mjs,cjs,json,md}\"",
    "format": "yarn format:sol && yarn format:ts",
    "format:check:sol": "prettier --check \"contracts/**/*.sol\"",
    "format:check:ts": "prettier --check \"**/*.{ts,mts,mjs,cjs,json,md}\"",
    "format:check": "sh -c 'yarn format:check:sol; r1=$?; yarn format:check:ts; r2=$?; exit $((r1 | r2))'",
    "check-types": "yarn build && tsc --noEmit"
  },
  "devDependencies": {
    "@foresight/eslint-config": "workspace:*",
    "@foresight/prettier-config": "workspace:*",
    "@foresight/typescript-config": "workspace:*",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomiclabs/hardhat-solhint": "hh2",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.3",
    "@wagmi/cli": "^2.3.2",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.28.0",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.19",
    "hardhat-deploy": "^1.0.4",
    "hardhat-deploy-ethers": "^0.4.2",
    "prettier": "^3.7.4",
    "prettier-plugin-solidity": "^1.4.2",
    "solhint-plugin-prettier": "^0.1.0",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.8.3",
    "viem": "^2.23.2"
  },
  "dependencies": {
    "@seer-pm/contracts": "^1.0.0"
  },
  "peerDependencies": {
    "viem": "^2.23.2"
  },
  "prettier": "./.prettierrc.cjs",
  "volta": {
    "extends": "../../package.json"
  }
}
