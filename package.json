{
  "name": "foresight",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write . --ignore-path .prettierignore.root && turbo run format",
    "format:check": "sh -c 'prettier --check . --ignore-path .prettierignore.root; r1=$?; turbo run format:check --continue=always; r2=$?; exit $((r1 | r2))'",
    "-": "---------------------------------------------------------------------------------------------",
    "local-stack": "./scripts/local-stack.sh start",
    "stop-local-stack": "./scripts/local-stack.sh stop",
    "mock-atlas": "yarn workspace @foresight/mock-atlas start",
    "dev:apps": "yarn turbo run dev --filter=web --filter=@foresight/devtools",
    "--": "--------------------------------------------------------------------------------------------",
    "dev": "yarn turbo run dev --filter=web",
    "dev:gnosis": "yarn workspace web dev:gnosis",
    "test:e2e": "yarn workspace web test:e2e",
    "---": "-------------------------------------------------------------------------------------------",
    "indexer:dev": "yarn workspace foresight-indexer dev",
    "indexer:dev:gnosis": "yarn workspace foresight-indexer dev:gnosis",
    "indexer:stop": "yarn workspace foresight-indexer stop",
    "indexer:update": "yarn workspace foresight-indexer update",
    "indexer:update:local": "yarn workspace foresight-indexer update:local",
    "indexer:update:gnosis": "yarn workspace foresight-indexer update:gnosis",
    "----": "------------------------------------------------------------------------------------------",
    "local-node:contracts": "yarn workspace @foresight/contracts start",
    "local-node:deploy": "yarn workspace @foresight/contracts deploy:local",
    "simulate:session": "yarn workspace @foresight/contracts simulate:session",
    "-----": "-----------------------------------------------------------------------------------------",
    "changelog": "conventional-changelog --infile CHANGELOG.md --same-file --release-count 0 && prettier --write CHANGELOG.md",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@foresight/prettier-config": "workspace:*",
    "conventional-changelog-cli": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.7.4",
    "turbo": "^2.7.1",
    "typescript": "^5.8.3"
  },
  "prettier": "@foresight/prettier-config",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=22"
  },
  "resolutions": {
    "undici": "6.21.2",
    "@internationalized/date": "3.12.3"
  },
  "volta": {
    "node": "22.23.2"
  }
}
